cabal-version: 3.0
name: grenade-benchmark
version: 0.1.0.0
build-type: Simple

executable grenade-iris
    main-is: Iris.hs
    hs-source-dirs: .
    default-language: GHC2021
    ghc-options: -Wall -threaded -rtsopts -O2
    build-depends: base >= 4.16 && < 5
                 , deepseq
                 , filepath
                 , grenade
                 , hmatrix
                 , json >= 0.11 && < 0.12
                 , vector


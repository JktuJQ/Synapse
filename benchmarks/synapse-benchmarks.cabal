cabal-version: 3.0
name:          synapse-benchmarks
version:       0.1.0.0
build-type:    Simple

executable synapse-benchmarks
    main-is:          Main.hs
    other-modules:    Fixture, Run
    default-language: GHC2024
    ghc-options:      -Wall -threaded
    build-depends:    base >= 4.20 && < 5
                    , bytestring
                    , cryptohash-sha256
                    , directory
                    , filepath
                    , json >= 0.11 && < 0.12
                    , optparse-applicative
                    , process
                    , random >= 1.3 && < 1.4

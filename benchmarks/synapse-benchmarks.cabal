cabal-version: 3.0
name:          synapse-benchmarks
version:       0.1.0.0
build-type:    Simple

executable synapse-benchmarks
    main-is:          Main.hs
    other-modules:    Checksum
                    , IrisFixture
                    , MnistFixture
                    , Run
                    , Task
    default-language: GHC2024
    ghc-options:      -Wall -threaded
    build-depends:    base >= 4.20 && < 5
                    , bytestring >= 0.11 && < 0.13
                    , cryptohash-sha256 >= 0.11.102 && < 0.12
                    , directory >= 1.3 && < 1.4
                    , filepath >= 1.4 && < 1.6
                    , json >= 0.11 && < 0.12
                    , optparse-applicative >= 0.19 && < 0.20
                    , process >= 1.6 && < 1.7
                    , random >= 1.3 && < 1.4

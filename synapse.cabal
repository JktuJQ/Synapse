cabal-version:      3.0
name:               synapse
version:            0.2.0.0
build-type:         Simple

author:             JktuJQ
maintainer:         odmamontov@gmail.com

homepage:           https://github.com/JktuJQ/Synapse
extra-doc-files:    README.md
                  , CHANGELOG.md
                  , SynapseLogo.png

extra-source-files: test/TensorTest/Ops/Convolution/Fixtures/Accepted/*.hs
                  , test/TensorTest/Ops/Convolution/Fixtures/Rejected/*.hs
                  , test/AutogradTest/Differentiable/Fixtures/Rejected/*.hs
                  , test/NNTest/Fixtures/Rejected/*.hs
                  , test/TensorTest/Shapes/Axes/Fixtures/Accepted/*.hs
                  , test/TensorTest/Shapes/Axes/Fixtures/Rejected/*.hs
                  , test/TensorTest/Ops/Index/Fixtures/Accepted/*.hs
                  , test/TensorTest/Ops/Index/Fixtures/Rejected/*.hs
                  , test/TensorTest/Ops/Reduction/Fixtures/Accepted/*.hs
                  , test/TensorTest/Ops/Reduction/Fixtures/Rejected/*.hs
                  , test/TensorTest/Ops/Math/Fixtures/Accepted/*.hs
                  , test/TensorTest/Ops/Math/Fixtures/Rejected/*.hs
                  , test/TensorTest/Ops/Elementwise/Fixtures/Accepted/*.hs
                  , test/TensorTest/Ops/Elementwise/Fixtures/Rejected/*.hs

license:            MIT
license-file:       LICENSE

synopsis:
    Type-safe neural networks in Haskell.
description:
    Synapse 2.0 is a work-in-progress rewrite focused on type-level tensor
    shapes, an Accelerate backend, pure autograd, and a compositional neural
    network API.
category:           Math


source-repository head
  type:     git
  location: https://github.com/JktuJQ/Synapse


flag gpu
    description: Enable the Accelerate LLVM PTX backend.
    default:     False
    manual:      True


common warnings
    ghc-options: -Wall

library
    import:           warnings
    default-language: Haskell2010

    build-depends:    base >= 4.19 && < 4.22
                    , array >= 0.5 && < 0.6
                    , containers >= 0.6 && < 0.9
                    , binary >= 0.8 && < 0.9
                    , bytestring >= 0.11 && < 0.13
                    , text >= 2.0 && < 2.2
                    , json >= 0.11 && < 0.12
                    , transformers >= 0.6 && < 0.7
                    , backprop >= 0.2.7.2 && < 0.3
                    , random >= 1.3 && < 1.4
                    , accelerate >= 1.3 && < 1.5
                    , accelerate-llvm-native >= 1.3 && < 1.5

    hs-source-dirs:   src
    exposed-modules:  Synapse
                    , Synapse.NN
                    , Synapse.NN.Weights
                    , Synapse.NN.Weights.Safetensors
                    , Synapse.NN.Data
                    , Synapse.NN.Data.Execution
                    , Synapse.NN.Gradient
                    , Synapse.NN.Loss
                    , Synapse.NN.Activation
                    , Synapse.NN.Layers.Position
                    , Synapse.NN.Layers.Attention
                    , Synapse.NN.Initialization
                    , Synapse.NN.Metrics
                    , Synapse.NN.Layers
                    , Synapse.NN.Layers.Convolution
                    , Synapse.NN.Forward
                    , Synapse.NN.Layers.Normalization
                    , Synapse.NN.Layers.Normalization.LayerNorm
                    , Synapse.NN.Layers.Normalization.BatchNorm
                    , Synapse.NN.Layers.Dropout
                    , Synapse.Tensor.Shapes.Normalization
                    , Synapse.NN.Layers.Dense
                    , Synapse.NN.Layers.Embedding
                    , Synapse.NN.Layers.Recurrent
                    , Synapse.NN.Layers.Recurrent.RNN
                    , Synapse.NN.Layers.Recurrent.GRU
                    , Synapse.NN.Layers.Recurrent.LSTM
                    , Synapse.NN.Optimizers
                    , Synapse.NN.Optimizers.Type
                    , Synapse.NN.Optimizers.SGD
                    , Synapse.NN.Optimizers.Adam
                    , Synapse.NN.Optimizers.RMSprop
                    , Synapse.Autograd
                    , Synapse.Autograd.Tensor
                    , Synapse.Autograd.Type
                    , Synapse.Autograd.Execution
                    , Synapse.Tensor
                    , Synapse.Tensor.Backend
                    , Synapse.Tensor.Ops.Construction
                    , Synapse.Tensor.Conversion
                    , Synapse.Tensor.Ops
                    , Synapse.Tensor.Ops.Elementwise
                    , Synapse.Tensor.Ops.Math
                    , Synapse.Tensor.Ops.Convolution
                    , Synapse.Tensor.Ops.Window
                    , Synapse.Tensor.Ops.Sequence
                    , Synapse.Tensor.Ops.Index
                    , Synapse.Tensor.Ops.Shape
                    , Synapse.Tensor.Ops.Reduction
                    , Synapse.Tensor.Shapes
                    , Synapse.Tensor.Shapes.Axes
                    , Synapse.Tensor.Shapes.Broadcast
                    , Synapse.Tensor.Shapes.Dimensions
                    , Synapse.Tensor.Shapes.Index
                    , Synapse.Tensor.Shapes.Reshape
                    , Synapse.Tensor.Shapes.Matmul
                    , Synapse.Tensor.Shapes.Convolution
                    , Synapse.Tensor.Shapes.Window
                    , Synapse.Tensor.Type
                    , Synapse.Tensor.Random

    other-modules:    Synapse.NN.Layers.Recurrent.Gates
                    , Synapse.Tensor.Backend.Structure
                    , Synapse.Tensor.Ops.Primitives.Sequence
                    , Synapse.Autograd.Tensor.Ops.Primitives.Sequence
                    , Synapse.Tensor.Ops.Structure
                    , Synapse.NN.Layers.Normalization.Statistics
                    , Synapse.Tensor.Fields
                    , Synapse.Tensor.Ops.Primitives.Convolution
                    , Synapse.Tensor.Ops.Primitives.Window
                    , Synapse.Autograd.Tensor.Ops.Primitives.Window
                    , Synapse.Autograd.Tensor.Ops.Primitives.Convolution
                    , Synapse.Tensor.Ops.Primitives.Construction
                    , Synapse.Tensor.Ops.Primitives.Index
                    , Synapse.Autograd.Execution.Variable
                    , Synapse.Tensor.Ops.Primitives.Math
                    , Synapse.Tensor.Ops.Primitives.Shape
                    , Synapse.Tensor.Ops.Primitives.Reduction
                    , Synapse.Autograd.Tensor.Ops.Primitives.Elementwise
                    , Synapse.Autograd.Tensor.Ops.Primitives.Math
                    , Synapse.Autograd.Tensor.Ops.Primitives.Index
                    , Synapse.Autograd.Tensor.Ops.Primitives.Shape
                    , Synapse.Autograd.Tensor.Ops.Primitives.Reduction
                    , Synapse.Tensor.Ops.Primitives.Elementwise
                    , Synapse.Autograd.Variable
                    , Synapse.Autograd.Execution.Reverse
                    , Synapse.Autograd.Tensor.Type
                    , Synapse.Autograd.Tensor.Ops
                    , Synapse.Autograd.Tensor.Ops.Elementwise

    if flag(gpu)
        cpp-options:   -DSYNAPSE_GPU
        build-depends: accelerate-llvm-ptx >= 1.3 && < 1.5

executable tensor-example
    import:           warnings
    ghc-options:      -threaded
    default-language: Haskell2010
    hs-source-dirs:   examples
    main-is:          Tensors.hs

    build-depends:    base >= 4.19 && < 4.22
                    , synapse

executable autograd-example
    import:           warnings
    ghc-options:      -threaded
    default-language: Haskell2010
    hs-source-dirs:   examples
    main-is:          Autograd.hs

    build-depends:    base >= 4.19 && < 4.22
                    , synapse

executable regression-example
    import:           warnings
    ghc-options:      -threaded
    default-language: Haskell2010
    hs-source-dirs:   examples
    main-is:          Regression.hs

    build-depends:    base >= 4.19 && < 4.22
                    , synapse
                    , random >= 1.3 && < 1.4

executable convolution-example
    import:           warnings
    ghc-options:      -threaded
    default-language: Haskell2010
    hs-source-dirs:   examples
    main-is:          Convolution.hs

    build-depends:    base >= 4.19 && < 4.22
                    , synapse
                    , random >= 1.3 && < 1.4

executable recurrent-example
    import:           warnings
    ghc-options:      -threaded
    default-language: Haskell2010
    hs-source-dirs:   examples
    main-is:          Recurrent.hs

    build-depends:    base >= 4.19 && < 4.22
                    , synapse
                    , random >= 1.3 && < 1.4

executable transformer-example
    import:           warnings
    ghc-options:      -threaded
    default-language: Haskell2010
    hs-source-dirs:   examples
    main-is:          Transformer.hs

    build-depends:    base >= 4.19 && < 4.22
                    , synapse
                    , random >= 1.3 && < 1.4

executable classification-example
    import:           warnings
    ghc-options:      -threaded
    default-language: Haskell2010
    hs-source-dirs:   examples
    main-is:          Classification.hs

    build-depends:    base >= 4.19 && < 4.22
                    , synapse

test-suite synapse-test
    import:           warnings
    ghc-options:      -threaded
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:    NNTest.Layers.Recurrent
                    , NNTest.Layers.Recurrent.Reference
                    , NNTest.Forward
                    , NNTest
                    , NNTest.Weights
                    , NNTest.Weights.Public
                    , NNTest.Weights.Safetensors
                    , NNTest.Data
                    , NNTest.Data.Execution
                    , NNTest.Gradient
                    , NNTest.Activation
                    , NNTest.Attention
                    , NNTest.Position
                    , NNTest.Initialization
                    , NNTest.Metrics
                    , NNTest.Layers
                    , NNTest.Layers.Convolution
                    , NNTest.Layers.Normalization
                    , NNTest.Layers.Dropout
                    , NNTest.Layers.Dense
                    , NNTest.Layers.Embedding
                    , NNTest.Network
                    , NNTest.Optimizer
                    , NNTest.Regression
                    , AutogradTest
                    , AutogradTest.Tensor
                    , AutogradTest.Tensor.Convolution
                    , AutogradTest.Tensor.Spatial
                    , AutogradTest.Tensor.Elementwise
                    , AutogradTest.Tensor.ElementLifting
                    , AutogradTest.Tensor.Lifting
                    , AutogradTest.Tensor.Sequence
                    , AutogradTest.Execution
                    , AutogradTest.Execution.Public
                    , AutogradTest.Differentiable
                    , TensorTest
                    , TensorTest.Backend
                    , TensorTest.Backend.Structure
                    , TensorTest.Random
                    , TensorTest.Construction
                    , TensorTest.Conversion
                    , TensorTest.Compiler
                    , TensorTest.Ops
                    , TensorTest.Ops.Elementwise
                    , TensorTest.Ops.Math
                    , TensorTest.Ops.Convolution
                    , TensorTest.Ops.Convolution.Dilated
                    , TensorTest.Ops.Spatial
                    , TensorTest.Ops.Spatial.Reference
                    , TensorTest.Ops.Convolution.Reference
                    , TensorTest.Ops.Math.Linear
                    , TensorTest.Ops.Index
                    , TensorTest.Ops.Index.Operations
                    , TensorTest.Ops.Index.Types
                    , TensorTest.Ops.Shape
                    , TensorTest.Ops.Reduction
                    , TensorTest.Ops.Reduction.Operations
                    , TensorTest.Ops.Reduction.Types
                    , TensorTest.Shapes
                    , TensorTest.Shapes.Axes
                    , TensorTest.Shapes.Dimensions
                    , TensorTest.Support

    build-depends:    base >= 4.19 && < 4.22
                    , transformers >= 0.6 && < 0.7
                    , bytestring >= 0.11 && < 0.13
                    , synapse
                    , accelerate >= 1.3 && < 1.5
                    , backprop >= 0.2.7.2 && < 0.3
                    , hedgehog >= 1.5 && < 1.8
                    , random >= 1.3 && < 1.4
                    , tasty >= 1.5 && < 1.6
                    , tasty-hedgehog >= 1.4 && < 1.5
                    , process >= 1.6 && < 1.7

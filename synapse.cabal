cabal-version:      3.0
name:               synapse
version:            0.2.0.0
build-type:         Simple

author:             JktuJQ
maintainer:         odmamontov@gmail.com

homepage:           https://github.com/JktuJQ/Synapse
extra-doc-files:    README.md
                  , CHANGELOG.md
                  , SynapseLogo.png

extra-source-files: test/TensorTest/Shapes/Axes/Fixtures/Accepted/*.hs
                  , test/TensorTest/Shapes/Axes/Fixtures/Rejected/*.hs
                  , test/TensorTest/Ops/Index/Fixtures/Accepted/*.hs
                  , test/TensorTest/Ops/Index/Fixtures/Rejected/*.hs
                  , test/TensorTest/Ops/Reduction/Fixtures/Accepted/*.hs
                  , test/TensorTest/Ops/Reduction/Fixtures/Rejected/*.hs
                  , test/TensorTest/Ops/Math/Fixtures/Accepted/*.hs
                  , test/TensorTest/Ops/Math/Fixtures/Rejected/*.hs

license:            MIT
license-file:       LICENSE

synopsis:
    Type-safe neural networks in Haskell.
description:
    Synapse 2.0 is a work-in-progress rewrite focused on type-level tensor
    shapes, an Accelerate backend, pure autograd, and a compositional neural
    network API.
category:           Math


source-repository head
  type:     git
  location: https://github.com/JktuJQ/Synapse


flag gpu
    description: Enable the Accelerate LLVM PTX backend.
    default:     False
    manual:      True


common warnings
    ghc-options: -Wall

library
    import:           warnings
    default-language: Haskell2010

    build-depends:    base >= 4.19 && < 4.22
                    , accelerate >= 1.3 && < 1.5
                    , accelerate-llvm-native >= 1.3 && < 1.5

    hs-source-dirs:   src
    exposed-modules:  Synapse
                    , Synapse.Tensor
                    , Synapse.Tensor.Backend
                    , Synapse.Tensor.Construction
                    , Synapse.Tensor.Conversion
                    , Synapse.Tensor.DType
                    , Synapse.Tensor.Ops.Elementwise
                    , Synapse.Tensor.Ops.Math
                    , Synapse.Tensor.Ops.Index
                    , Synapse.Tensor.Ops.Shape
                    , Synapse.Tensor.Ops.Reduction
                    , Synapse.Tensor.Shapes
                    , Synapse.Tensor.Shapes.Axes
                    , Synapse.Tensor.Shapes.Broadcast
                    , Synapse.Tensor.Shapes.Dimensions
                    , Synapse.Tensor.Shapes.Index
                    , Synapse.Tensor.Shapes.Reshape
                    , Synapse.Tensor.Shapes.Matmul
                    , Synapse.Tensor.Type

    if flag(gpu)
        cpp-options:   -DSYNAPSE_GPU
        build-depends: accelerate-llvm-ptx >= 1.3 && < 1.5

test-suite synapse-test
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:    TensorTest
                    , TensorTest.Backend
                    , TensorTest.Construction
                    , TensorTest.Conversion
                    , TensorTest.Compiler
                    , TensorTest.Ops
                    , TensorTest.Ops.Elementwise
                    , TensorTest.Ops.Math
                    , TensorTest.Ops.Math.Linear
                    , TensorTest.Ops.Index
                    , TensorTest.Ops.Index.Operations
                    , TensorTest.Ops.Index.Types
                    , TensorTest.Ops.Shape
                    , TensorTest.Ops.Reduction
                    , TensorTest.Ops.Reduction.Operations
                    , TensorTest.Ops.Reduction.Types
                    , TensorTest.Shapes
                    , TensorTest.Shapes.Axes
                    , TensorTest.Shapes.Dimensions
                    , TensorTest.Support

    build-depends:    base >= 4.19 && < 4.22
                    , synapse
                    , accelerate >= 1.3 && < 1.5
                    , hedgehog >= 1.5 && < 1.8
                    , tasty >= 1.5 && < 1.6
                    , tasty-hedgehog >= 1.4 && < 1.5
                    , process >= 1.6 && < 1.7

cabal-version:      3.0
name:               synapse
version:            0.2.0.0
build-type:         Simple

author:             JktuJQ
maintainer:         odmamontov@gmail.com

homepage:           https://github.com/JktuJQ/Synapse
extra-doc-files:    CHANGELOG.md
                  , README.md
                  , SynapseLogo.png

                  , examples/iris/README.md
                  , examples/mnist/README.md

extra-source-files: test/**/*.hs

license:            MIT
license-file:       LICENSE

synopsis:           Typed tensor and neural networks
description:
    Staged tensor computations with type-level shapes,
    reverse-mode automatic differentiation,
    and composable neural network layers in pure Haskell.
category:           Math


source-repository head
  type:     git
  location: https://github.com/JktuJQ/Synapse


flag blas
    description: Enable CBLAS on CPU and cuBLAS with the GPU backend.
    default:     False
    manual:      True

flag gpu
    description: Enable LLVM PTX backend.
    default:     False
    manual:      True


common warnings
    ghc-options: -Wall

library
    import:           warnings
    default-language: GHC2024

    build-depends:    accelerate >= 1.3 && < 1.5
                    , accelerate-llvm-native >= 1.3 && < 1.5
                    , array >= 0.5 && < 0.6
                    , backprop >= 0.2.7.2 && < 0.3
                    , base >= 4.20 && < 4.22
                    , binary >= 0.8 && < 0.9
                    , bytestring >= 0.11 && < 0.13
                    , containers >= 0.6 && < 0.9
                    , json >= 0.11 && < 0.12
                    , random >= 1.3 && < 1.4
                    , template-haskell >= 2.22 && < 2.24
                    , text >= 2.0 && < 2.2
                    , transformers >= 0.6 && < 0.7

    hs-source-dirs:   src
    exposed-modules:  Synapse
                    , Synapse.Autograd
                    , Synapse.Autograd.Execution
                    , Synapse.Autograd.Representation
                    , Synapse.Autograd.Tensor
                    , Synapse.Autograd.Tensor.Representation
                    , Synapse.NN
                    , Synapse.NN.Activation
                    , Synapse.NN.Data
                    , Synapse.NN.Forward
                    , Synapse.NN.Gradient
                    , Synapse.NN.Initialization
                    , Synapse.NN.Layers
                    , Synapse.NN.Layers.Attention
                    , Synapse.NN.Layers.Convolution
                    , Synapse.NN.Layers.Dense
                    , Synapse.NN.Layers.Dropout
                    , Synapse.NN.Layers.Embedding
                    , Synapse.NN.Layers.Normalization
                    , Synapse.NN.Layers.Normalization.BatchNorm
                    , Synapse.NN.Layers.Normalization.LayerNorm
                    , Synapse.NN.Layers.Position
                    , Synapse.NN.Layers.Recurrent
                    , Synapse.NN.Layers.Recurrent.GRU
                    , Synapse.NN.Layers.Recurrent.LSTM
                    , Synapse.NN.Layers.Recurrent.RNN
                    , Synapse.NN.Loss
                    , Synapse.NN.Loss.Classification
                    , Synapse.NN.Loss.Regression
                    , Synapse.NN.Metrics
                    , Synapse.NN.Metrics.Classification
                    , Synapse.NN.Metrics.Regression
                    , Synapse.NN.Optimizers
                    , Synapse.NN.Optimizers.Adam
                    , Synapse.NN.Optimizers.Optimizer
                    , Synapse.NN.Optimizers.RMSprop
                    , Synapse.NN.Optimizers.SGD
                    , Synapse.NN.Weights
                    , Synapse.NN.Weights.Safetensors
                    , Synapse.Tensor
                    , Synapse.Tensor.Backend
                    , Synapse.Tensor.Data
                    , Synapse.Tensor.Ops
                    , Synapse.Tensor.Ops.Constraints
                    , Synapse.Tensor.Ops.Construction
                    , Synapse.Tensor.Ops.Conversion
                    , Synapse.Tensor.Ops.Execution
                    , Synapse.Tensor.Ops.Index
                    , Synapse.Tensor.Ops.Logic
                    , Synapse.Tensor.Ops.Math
                    , Synapse.Tensor.Ops.Numeric
                    , Synapse.Tensor.Ops.Random
                    , Synapse.Tensor.Ops.Reduction
                    , Synapse.Tensor.Ops.Shape
                    , Synapse.Tensor.Ops.Window
                    , Synapse.Tensor.Representation
                    , Synapse.Tensor.Shapes
                    , Synapse.Tensor.Shapes.Axes
                    , Synapse.Tensor.Shapes.Backend
                    , Synapse.Tensor.Shapes.Broadcast
                    , Synapse.Tensor.Shapes.Dimensions
                    , Synapse.Tensor.Shapes.Index
                    , Synapse.Tensor.Shapes.Matmul
                    , Synapse.Tensor.Shapes.Normalization
                    , Synapse.Tensor.Shapes.Reshape
                    , Synapse.Tensor.Shapes.Window
                    , Synapse.Tensor.Structure

    other-modules:    Synapse.Autograd.Record
                    , Synapse.Autograd.Tensor.Ops
                    , Synapse.Autograd.Tensor.Ops.Conversion
                    , Synapse.Autograd.Tensor.Ops.Logic
                    , Synapse.Autograd.Tensor.Ops.Math
                    , Synapse.Autograd.Tensor.Ops.Numeric
                    , Synapse.Autograd.Tensor.Ops.Pullback.Index
                    , Synapse.Autograd.Tensor.Ops.Pullback.Logic
                    , Synapse.Autograd.Tensor.Ops.Pullback.Math
                    , Synapse.Autograd.Tensor.Ops.Pullback.Numeric
                    , Synapse.Autograd.Tensor.Ops.Pullback.Reduction
                    , Synapse.Autograd.Tensor.Ops.Pullback.Shape
                    , Synapse.Autograd.Tensor.Ops.Pullback.Window
                    , Synapse.NN.Layers.Recurrent.Sequence
                    , Synapse.Tensor.Ops.Definition
                    , Synapse.Tensor.Ops.Raw.Construction
                    , Synapse.Tensor.Ops.Raw.Elementwise
                    , Synapse.Tensor.Ops.Raw.GEMM
                    , Synapse.Tensor.Ops.Raw.Index
                    , Synapse.Tensor.Ops.Raw.Math
                    , Synapse.Tensor.Ops.Raw.Random
                    , Synapse.Tensor.Ops.Raw.Reduction
                    , Synapse.Tensor.Ops.Raw.Shape
                    , Synapse.Tensor.Ops.Raw.Window
                    , Synapse.Tensor.Structure.Constraints
                    , Synapse.Tensor.Structure.Product

    if flag(blas)
        cpp-options:      -DSYNAPSE_BLAS
        extra-libraries:  blas

        if flag(gpu)
            extra-libraries: cublas

    if flag(gpu)
        cpp-options:   -DSYNAPSE_GPU
        build-depends: accelerate-llvm-ptx >= 1.3 && < 1.5
                     , cuda >= 0.10 && < 0.14

test-suite synapse-test
    import:           warnings
    ghc-options:      -threaded
    default-language: GHC2024
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:    AutogradTest
                    , AutogradTest.Differentiable
                    , AutogradTest.Execution
                    , AutogradTest.Execution.Public
                    , AutogradTest.Tensor
                    , AutogradTest.Tensor.Convolution
                    , AutogradTest.Tensor.ElementLifting
                    , AutogradTest.Tensor.Elementwise
                    , AutogradTest.Tensor.Lifting
                    , AutogradTest.Tensor.Spatial
                    , NNTest
                    , NNTest.Activation
                    , NNTest.Attention
                    , NNTest.Data
                    , NNTest.Data.Execution
                    , NNTest.Forward
                    , NNTest.Gradient
                    , NNTest.Initialization
                    , NNTest.Layers
                    , NNTest.Layers.Convolution
                    , NNTest.Layers.Dense
                    , NNTest.Layers.Dropout
                    , NNTest.Layers.Embedding
                    , NNTest.Layers.Normalization
                    , NNTest.Layers.Recurrent
                    , NNTest.Layers.Recurrent.Reference
                    , NNTest.Metrics
                    , NNTest.Network
                    , NNTest.Optimizer
                    , NNTest.Position
                    , NNTest.Regression
                    , NNTest.Weights
                    , NNTest.Weights.Public
                    , NNTest.Weights.Safetensors
                    , TensorTest
                    , TensorTest.Backend
                    , TensorTest.Backend.Structure
                    , TensorTest.Compiler
                    , TensorTest.Construction
                    , TensorTest.Conversion
                    , TensorTest.Ops
                    , TensorTest.Ops.Convolution
                    , TensorTest.Ops.Convolution.Dilated
                    , TensorTest.Ops.Convolution.Reference
                    , TensorTest.Ops.Elementwise
                    , TensorTest.Ops.Index
                    , TensorTest.Ops.Index.Operations
                    , TensorTest.Ops.Index.Types
                    , TensorTest.Ops.Math
                    , TensorTest.Ops.Math.Linear
                    , TensorTest.Ops.Reduction
                    , TensorTest.Ops.Reduction.Masked
                    , TensorTest.Ops.Reduction.Operations
                    , TensorTest.Ops.Reduction.Types
                    , TensorTest.Ops.Shape
                    , TensorTest.Ops.Spatial
                    , TensorTest.Ops.Spatial.Reference
                    , TensorTest.Random
                    , TensorTest.Shapes
                    , TensorTest.Shapes.Axes
                    , TensorTest.Shapes.Dimensions
                    , TensorTest.Support

    build-depends:    synapse
                    , accelerate >= 1.3 && < 1.5
                    , accelerate-llvm-native >= 1.3 && < 1.5
                    , backprop >= 0.2.7.2 && < 0.3
                    , base >= 4.20 && < 4.22
                    , bytestring >= 0.11 && < 0.13
                    , containers >= 0.6 && < 0.9
                    , hedgehog >= 1.5 && < 1.8
                    , process >= 1.6 && < 1.7
                    , random >= 1.3 && < 1.4
                    , tasty >= 1.5 && < 1.6
                    , tasty-hedgehog >= 1.4 && < 1.5
                    , transformers >= 0.6 && < 0.7

executable tensor-example
    import:           warnings
    ghc-options:      -threaded
    default-language: GHC2024
    hs-source-dirs:   examples/overview
    main-is:          Tensor.lhs

    build-depends:    synapse
                    , base >= 4.20 && < 4.22

executable autograd-example
    import:           warnings
    ghc-options:      -threaded
    default-language: GHC2024
    hs-source-dirs:   examples/overview
    main-is:          Autograd.lhs

    build-depends:    synapse
                    , base >= 4.20 && < 4.22

executable regression-example
    import:           warnings
    ghc-options:      -threaded
    default-language: GHC2024
    hs-source-dirs:   examples/overview
    main-is:          NN/Regression.lhs

    build-depends:    synapse
                    , base >= 4.20 && < 4.22
                    , random >= 1.3 && < 1.4
                    , transformers >= 0.6 && < 0.7

executable classification-example
    import:           warnings
    ghc-options:      -threaded
    default-language: GHC2024
    hs-source-dirs:   examples/overview
    main-is:          NN/Classification.lhs

    build-depends:    synapse
                    , base >= 4.20 && < 4.22
                    , random >= 1.3 && < 1.4
                    , transformers >= 0.6 && < 0.7

executable convolution-example
    import:           warnings
    ghc-options:      -threaded
    default-language: GHC2024
    hs-source-dirs:   examples/overview
    main-is:          NN/Convolution.lhs

    build-depends:    synapse
                    , base >= 4.20 && < 4.22
                    , random >= 1.3 && < 1.4
                    , transformers >= 0.6 && < 0.7

executable recurrent-example
    import:           warnings
    ghc-options:      -threaded
    default-language: GHC2024
    hs-source-dirs:   examples/overview
    main-is:          NN/Recurrent.lhs

    build-depends:    synapse
                    , base >= 4.20 && < 4.22
                    , random >= 1.3 && < 1.4
                    , transformers >= 0.6 && < 0.7

executable transformer-example
    import:           warnings
    ghc-options:      -threaded
    default-language: GHC2024
    hs-source-dirs:   examples/overview
    main-is:          NN/Transformer.lhs

    build-depends:    synapse
                    , base >= 4.20 && < 4.22
                    , random >= 1.3 && < 1.4
                    , transformers >= 0.6 && < 0.7

executable iris-example
    import:           warnings
    ghc-options:      -threaded
    default-language: GHC2024
    hs-source-dirs:   examples/iris
    main-is:          Main.hs
    other-modules:    Data
                    , Evaluate
                    , Model
                    , Train

    build-depends:    synapse
                    , base >= 4.20 && < 4.22
                    , random >= 1.3 && < 1.4

executable mnist-example
    import:           warnings
    ghc-options:      -threaded
    default-language: GHC2024
    hs-source-dirs:   examples/mnist
    main-is:          Main.hs
    other-modules:    Data
                    , Evaluate
                    , Model
                    , Train

    build-depends:    synapse
                    , base >= 4.20 && < 4.22
                    , bytestring >= 0.11 && < 0.13
                    , filepath >= 1.4 && < 1.6
                    , random >= 1.3 && < 1.4
                    , transformers >= 0.6 && < 0.7
